# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mypos_db

# Generate a fresh one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Where the frontend runs (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shop rules
LATE_FEE_PER_DAY=200
LOW_STOCK_THRESHOLD=3
UTC_OFFSET_HOURS=2
RECEIPT_PREFIX=CL
